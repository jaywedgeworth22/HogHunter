<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  2026-09-22 — bundle ID migration added these two entitlements:

    com.apple.security.application-groups    -> [group.com.simplewithus.hoghunter]
        New App Group.  No shared container or UserDefaults suite is wired
        up by the app yet, but the entitlement must be present (and the
        App Group must be registered in the Apple Developer Portal per
        App ID) before any future share-with-helper feature lands.
        Existing local state lives under ~/Library/Logs/HogHunter/ and the
        internal Application Support directory "HogHunter"; renaming those
        would orphan user history, so they are intentionally NOT renamed —
        only the bundle ID and the new App Group + Associated Domain move.

    com.apple.developer.associated-domains -> [applinks:simplewithus.com, webcredentials:simplewithus.com]
        New Associated Domain on simplewithus.com (Jay-owned, resolves).
        Universal Links (applinks) and shared Safari webcredentials
        (webcredentials) are wired up; they will validate once the
        apple-app-site-association file is hosted at
        https://simplewithus.com/.well-known/apple-app-site-association.

  See docs/rollouts/2026-09-22-bundle-id-migration.md for the full
  fleet-wide migration context.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.simplewithus.hoghunter</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:simplewithus.com</string>
		<string>webcredentials:simplewithus.com</string>
	</array>
</dict>
</plist>